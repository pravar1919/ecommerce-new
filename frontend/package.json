{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "lighthouse": "node scripts/lighthouse.mjs",
    "api:types": "openapi-typescript ../backend/schema/openapi.yaml -o src/lib/api/schema.d.ts",
    "api:check": "openapi-typescript ../backend/schema/openapi.yaml -o src/lib/api/schema.d.ts && git diff --exit-code -- src/lib/api/schema.d.ts",
    "cn:build": "cn build --cwd src --content '**/*.{ts,tsx}' --out lib/cn-tables.ts --quiet",
    "cn:check": "npm run cn:build && git diff --exit-code -- src/lib/cn-tables.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "gsap": "^3.15.1",
    "lucide-react": "^1.73.0",
    "motion": "^12.43.0",
    "next": "16.4.6",
    "openapi-fetch": "^0.17.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "^4.14.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jsdom": "^29.1.1",
    "lighthouse": "^12.8.2",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.0",
    "vitest-axe": "^0.1.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
