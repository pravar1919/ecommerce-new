# Single origin for storefront, admin and API (see docs/architecture.md §2).
{$SITE_ADDRESS::80} {
	encode zstd gzip

	request_header X-Request-ID {http.request.uuid}

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	@backend path /api/* /django-admin/* /static/*
	handle @backend {
		reverse_proxy {$BACKEND_UPSTREAM:backend:8000}
	}

	handle {
		reverse_proxy {$FRONTEND_UPSTREAM:frontend:3000}
	}
}
