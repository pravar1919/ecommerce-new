# ---------------------------------------------------------------------------
# Copy to .env for local development:  cp .env.example .env
# NEVER commit .env. Production secrets come from the host secret store.
# ---------------------------------------------------------------------------

# --- General ---------------------------------------------------------------
# development | test | staging | production
ENVIRONMENT=development
# public origin (served by Caddy)
SITE_URL=http://localhost:8080
# Caddy site address; in production e.g. shop.example.com
SITE_ADDRESS=:80

# --- Brand (seed / fallback only; editable in admin via cms.SiteSettings) ---
# Dev identity. Production startup refuses BRAND_NAME=ATELIER.
BRAND_NAME=ATELIER
BRAND_TAGLINE=Occasion wear, crafted.
# heirloom (approved) | dev
BRAND_THEME=heirloom
ORDER_NUMBER_PREFIX=AT

# --- Django -----------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me-dev-only-not-a-real-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
# :3000 = `npm run dev` on the host without Caddy
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://localhost:3000
DJANGO_ADMIN_URL=django-admin/
LOG_LEVEL=INFO
# console | json
LOG_FORMAT=console

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_DB=ecommerce
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=ecommerce-dev
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# host-side port; change if 5432 is taken locally
POSTGRES_HOST_PORT=5432
DATABASE_URL=postgres://ecommerce:ecommerce-dev@postgres:5432/ecommerce

# --- Redis / Celery -----------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
REDIS_HOST_PORT=6379

# --- S3-compatible storage (SeaweedFS in dev; S3 / R2 / Spaces in production) ----
AWS_ACCESS_KEY_ID=s3-dev
AWS_SECRET_ACCESS_KEY=s3-dev-secret
AWS_STORAGE_BUCKET_NAME=ecommerce-media
AWS_S3_REGION_NAME=ap-south-1
# internal endpoint (backend → storage)
AWS_S3_ENDPOINT_URL=http://s3:9000
# endpoint browsers use for presigned URLs
AWS_S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_HOST_PORT=9000
MEDIA_PUBLIC_BASE_URL=http://localhost:9000/ecommerce-media/public
# where the Next.js server fetches public media for /media/* (same-origin, image optimisation)
MEDIA_INTERNAL_URL=http://s3:9000/ecommerce-media/public

# --- Payments: Razorpay (use TEST keys outside production) --------------------
# fake | razorpay
PAYMENT_GATEWAY=fake
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CHECKOUT_RESERVATION_TTL_MINUTES=15
PAYMENT_RETRY_WINDOW_MINUTES=30

# --- Shipping ----------------------------------------------------------------
# manual | shiprocket | delhivery (Phase 7)
SHIPPING_PROVIDER=manual
SHIPPING_API_KEY=
SHIPPING_API_SECRET=
# GST state code of dispatch location (27 = Maharashtra)
SELLER_STATE_CODE=27

# --- Email -------------------------------------------------------------------
# smtp | console | ses | postmark
EMAIL_PROVIDER=smtp
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=orders@localhost

# --- SMS ---------------------------------------------------------------------
# console | msg91
SMS_PROVIDER=console
SMS_API_KEY=
SMS_SENDER_ID=

# --- Frontend ----------------------------------------------------------------
# server-side fetches from Next.js
INTERNAL_API_URL=http://backend:8000
# browser fetches (same origin via Caddy)
NEXT_PUBLIC_API_BASE=/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:8080
NEXT_PUBLIC_BRAND_NAME=ATELIER
NEXT_PUBLIC_BRAND_THEME=heirloom
NEXT_PUBLIC_ENVIRONMENT=development
REVALIDATE_SECRET=change-me-dev-only
# Django → Next.js on-demand ISR revalidation (internal network)
FRONTEND_REVALIDATE_URL=http://frontend:3000/api/revalidate
# newsletter signups per IP (dev is generous so E2E can run repeatedly)
THROTTLE_NEWSLETTER=60/hour

# --- Observability (optional) -------------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
