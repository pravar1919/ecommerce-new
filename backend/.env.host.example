# Copy to .env.host and adjust ports if needed (e.g. POSTGRES_HOST_PORT in the root .env).
# Overrides for running Django on the host (outside Docker) against the compose infra.
# Usage: set -a; source .env.host; set +a   (see Makefile)
DATABASE_URL=postgres://ecommerce:ecommerce-dev@localhost:5432/ecommerce
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
AWS_S3_ENDPOINT_URL=http://localhost:9000
EMAIL_HOST=localhost
